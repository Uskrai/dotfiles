font=JetBrains Mono 10
background-color=#0d1117D9
text-color=#e6edf3
border-size=1
border-color=#30363d
border-radius=0

width=400
height=300
outer-margin=50,10
margin=0
padding=8,10
anchor=top-right
layer=overlay

icons=1
max-icon-size=64
icon-path=/usr/share/icons/gnome/16x16/status:/usr/share/icons/gnome/16x16/devices

markup=1
format=%s\n%b
text-alignment=left

default-timeout=10000
ignore-timeout=0
max-history=20
sort=-priority
max-visible=5

on-button-left=dismiss
on-button-middle=invoke-default-action
on-button-right=dismiss-all

[urgency=low]
background-color=#0d1117D9
text-color=#6e7681
default-timeout=10000

[urgency=normal]
background-color=#0d1117D9
text-color=#58a6ff
default-timeout=10000

[urgency=critical]
background-color=#ff7b72D9
text-color=#0d1117
border-color=#ff7b72
border-size=2
default-timeout=0

[app-name=Brave]
invisible=1
