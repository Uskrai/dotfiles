#!/bin/sh

set -Ceu

# Zellij: curses don't work well there. Zellij sets $ZELLIJ=0
# inside a session or session name when nested, so any non-empty value counts.
if [[ -n "${ZELLIJ-}" && -x $(command -v pinentry-zellij) ]]; then
	# https://github.com/likewhatevs/pinentry-zellij
	exec pinentry-zellij "$@"
	return
fi

# if [[ -n "${TMUX}" ]]; then
# 	exec pinentry-tmux "$@"
# 	return
# fi


if [[ "${PINENTRY_USER_DATA-}" == *USE_TTY=1* ]]; then
	exec pinentry-curses "$@"
	return
fi

exec pinentry-curses "$@"
