#!/bin/sh

set -Ceu

# pi TUI / Zellij: curses don't work well there. Zellij sets $ZELLIJ=0
# inside a session or session name when nested, so any non-empty value counts.
if [[ "${PI_CODING_AGENT-}" == "true" || -n "${ZELLIJ-}" ]]; then
	exec pinentry-qt "$@"
	return
fi

if [[ "${PINENTRY_USER_DATA-}" == *USE_TTY=1* ]]; then
	exec pinentry-curses "$@"
	return
fi

exec pinentry-qt "$@"
